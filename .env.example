# ==============================
# Decentralized Music Streaming System - Environment Variables
# Copy this file to .env and fill in your own values
# ==============================

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_streaming_db

# ---- JWT Auth ----
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- App ----
APP_NAME=Decentralized Music Streaming System
DEBUG=True
API_V1_PREFIX=/api/v1

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:3000

# ---- Storage ----
# Path is relative to the backend/ working directory
STORAGE_NODES_PATH=../storage_nodes
STORAGE_NODE_COUNT=5
LOAD_BALANCING_ALGORITHM=round_robin
# options: round_robin, least_used, random

# ---- Uploads ----
UPLOADS_PATH=../uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Cache ----
LRU_CACHE_SIZE=50

# ---- Email (Optional) ----
# Leave blank to use console-simulated emails (verification codes / reset links
# print to the backend terminal). Fill these in to send REAL emails, e.g. via
# a Gmail App Password (not your normal Gmail password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=youraddress@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM_EMAIL=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True
VERIFICATION_CODE_EXPIRE_MINUTES=15
